<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. ESTILO PARA LA FOTO  -->
    <Style TargetType="Image" x:Key="EstiloVisorImagen">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="20"/>
        <!-- Suaviza los píxeles si el usuario hace zoom -->
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>

    <!-- 2. ESTILO PARA EL REPRODUCTOR DE VÍDEO/AUDIO -->
    <Style TargetType="MediaElement" x:Key="EstiloVisorMedia">
        <Setter Property="LoadedBehavior" Value="Manual"/>
        <Setter Property="ScrubbingEnabled" Value="True"/>
        <Setter Property="Margin" Value="20"/>
    </Style>

    <!-- 3. ESTILO PARA FICHEROS DE TEXTO -->
    <Style TargetType="TextBox" x:Key="EstiloVisorTexto">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <!-- Tipografía de código/texto plano -->
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>