<Application x:Class="VIS02_JoseCarlosGomezLobo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="NaveWin.xaml">
    <Application.Resources>

        <!-- 1. DEFINIMOS LAS PALETAS DE COLORES -->
        <SolidColorBrush x:Key="FondoNormal" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="TextoNormal" Color="#111111"/>

        <SolidColorBrush x:Key="FondoNoche" Color="#222222"/>
        <SolidColorBrush x:Key="TextoNoche" Color="#EEEEEE"/>

        <!-- La variable que irá cambiando  -->
        <SolidColorBrush x:Key="FondoActual" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="TextoActual" Color="#111111"/>

        <!-- 2. APLICAMOS EL COLOR GLOBALMENTE  -->
        <Style TargetType="Grid">
            <Setter Property="Background" Value="{DynamicResource FondoActual}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FondoActual}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextoActual}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextoActual}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextoActual}"/>
        </Style>

    </Application.Resources>
</Application>