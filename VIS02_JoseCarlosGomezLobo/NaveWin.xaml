<Window x:Class="VIS02_JoseCarlosGomezLobo.NaveWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HiperGaleria - Navegador" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FondoActual}"
        Foreground="{DynamicResource TextoActual}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
             
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
  
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="btnCambiarCarpeta" Content="Seleccionar otra carpeta..." Click="btnCambiarCarpeta_Click"/>
            <TextBlock x:Name="txtRutaActual" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="14"/>
            <Button x:Name="btnModoOscuro" Content="🌙 Modo Noche" Click="btnModoOscuro_Click" Margin="15,0,0,0"/>
        </StackPanel>

        <TreeView x:Name="treeArchivos" Grid.Row="1" SelectedItemChanged="treeArchivos_SelectedItemChanged"
                  BorderBrush="{DynamicResource TextoActual}" BorderThickness="1" Padding="5"
                  Background="Transparent" Foreground="{DynamicResource TextoActual}"/>
    </Grid>
</Window>