<Window x:Class="UltimateSupervisor.DetailWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del Archivo" Height="600" Width="800"
        Closing="Window_Closing">

	<Grid x:Name="gridDetalle" Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="10" ClipToBounds="True">

			<!-- Visor para Imagen con Zoom -->
			<Image x:Name="VisorImagen" Visibility="Collapsed">
				<Image.RenderTransform>
					<ScaleTransform x:Name="TransformacionZoom" ScaleX="1" ScaleY="1" />
				</Image.RenderTransform>
			</Image>

			<!-- Visor de Video/Audio -->
			<MediaElement x:Name="VisorMedia" Visibility="Collapsed"
                          LoadedBehavior="Manual" UnloadedBehavior="Stop"/>

			<!-- Visor de Texto Plano (.txt) -->
			<TextBox x:Name="VisorTexto" Visibility="Collapsed"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"/>

			<!-- Visor para Markdown (.md) usando TextBox nativo -->
			<TextBox x:Name="VisorMarkdown" Visibility="Collapsed"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas"/>

		</Grid>

		<!-- BOTONES -->
		<Grid Grid.Row="1" Margin="10,10,10,0">

			<StackPanel x:Name="PanelBotonesImagen" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
				<Button Content="Zoom +" Click="BtnZoomIn_Click" Margin="5" Padding="5"/>
				<Button Content="Zoom -" Click="BtnZoomOut_Click" Margin="5" Padding="5"/>
			</StackPanel>

			<StackPanel x:Name="PanelBotonesMedia" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
				<Button Content="Play" Click="BtnPlay_Click" Margin="5" Padding="5"/>
				<Button Content="Pause" Click="BtnPause_Click" Margin="5" Padding="5"/>
			</StackPanel>

			<StackPanel x:Name="PanelBotonesTexto" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
				<Button Content="Fuente +" Click="BtnFontUp_Click" Margin="5" Padding="5"/>
				<Button Content="Fuente -" Click="BtnFontDown_Click" Margin="5" Padding="5"/>
			</StackPanel>

			<!-- Botón de cerrar -->
			<Button Content="Cerrar" IsCancel="True" HorizontalAlignment="Right" Click="BtnCerrar_Click" Margin="5" Padding="10,5"/>
		</Grid>
	</Grid>
</Window>